# Required: the API listens on this internal container port.
PORT=3000

# Required by prisma.config.ts for migrate deploy. In a container, DB_HOST is
# the existing MySQL container name, not localhost.
DB_HOST=nama-container-mysql
DB_PORT=3306
DB_USER=svms_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
DB_NAME=svms

# Required by the Prisma schema. Example:
# mysql://svms_user:PASSWORD@nama-container-mysql:3306/svms
DATABASE_URL="mysql://svms_user:PASSWORD@nama-container-mysql:3306/svms"

# Optional for production migrate deploy; used by migrate dev only.
SHADOW_DATABASE_URL=""

# Required: use a long random value in production.
JWT_SECRET="GANTI_DENGAN_SECRET_ACAK_PANJANG"
JWT_EXPIRES_IN="1d"

# Set false only when migrations are managed outside the container.
RUN_MIGRATIONS=true
