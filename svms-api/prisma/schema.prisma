// ============================================================
// SVMS Prototype (demo pelatihan) — schema minimal, MySQL
// 4 tabel: users, venues, courts, bookings
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  ADMIN     // pengelola venue: CRUD venue, court, lihat semua booking
  CUSTOMER  // pemesan: lihat venue, buat & batalkan booking sendiri
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255) // simpan hash (bcrypt), bukan teks biasa
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")

  bookings Booking[]

  @@map("users")
}

model Venue {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  type        String   @db.VarChar(50) // contoh: Badminton, Futsal, Padel
  address     String   @db.Text
  city        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  courts Court[]

  @@map("venues")
}

model Court {
  id           Int     @id @default(autoincrement())
  venueId      Int     @map("venue_id")
  name         String  @db.VarChar(100) // contoh: Lapangan 1
  pricePerHour Decimal @map("price_per_hour") @db.Decimal(12, 2)
  isActive     Boolean @default(true) @map("is_active")

  venue    Venue     @relation(fields: [venueId], references: [id])
  bookings Booking[]

  @@map("courts")
}

model Booking {
  id         Int           @id @default(autoincrement())
  userId     Int           @map("user_id")
  courtId    Int           @map("court_id")
  startTime  DateTime      @map("start_time")
  endTime    DateTime      @map("end_time")
  totalPrice Decimal       @map("total_price") @db.Decimal(12, 2)
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  court Court @relation(fields: [courtId], references: [id])

  @@index([courtId, startTime])
  @@map("bookings")
}